[Unit]
Description=Voice launcher (hey jarvis -> dev-layout)
# Precisa do WAYLAND_DISPLAY (wl-copy/wtype/quickshell): só sobe depois que o
# compositor exporta o ambiente para o systemd --user (graphical-session.target)
After=pipewire.service pipewire-pulse.service graphical-session.target
Wants=pipewire.service pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voice-launcher
Restart=on-failure
RestartSec=5
# journalctl --user -u voice-launcher -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target

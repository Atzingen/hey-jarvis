#!/bin/bash
# wrapper: runs voice-launcher.py inside the Jarvis Python environment — the
# venv created by install.sh from the hash-locked requirements. Nothing else
# (no conda, no system site-packages) is used.
set -e
VENV="$HOME/.local/share/jarvis/venv"
if [ ! -x "$VENV/bin/python" ]; then
    echo "jarvis: $VENV is missing — run install.sh" >&2
    exit 1
fi
export PATH="$VENV/bin:$PATH"   # piper lives in the env's bin
exec "$VENV/bin/python" -u "$HOME/.local/bin/voice-launcher.py" "$@"

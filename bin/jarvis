#!/bin/bash
# jarvis — controla o serviço voice-launcher.service
#
# uso:
#   jarvis on | off | toggle
#   jarvis status             # JSON pro waybar
#   jarvis status-short       # 'on' ou 'off'
#   jarvis pause <duração>    # off agora, on depois (ex: jarvis pause 45m)
#   jarvis wake on|off|toggle|status   # só a escuta do "hey jarvis" (mic fecha; atalhos seguem)
#   jarvis log                # journalctl -f no serviço
#   jarvis dictate [toggle|start|stop|cancel]   # ditado: transcreve e cola na janela ativa
#   jarvis app                # tela principal (status, guia, ditado, ações) em terminal flutuante
#   jarvis config             # tela de configuração (terminal flutuante)
#   jarvis config show|get <k>|set <k> <v>|reset [<k>]|path
#
#   jarvis pause-meeting         # (uso interno do watcher de reunião)
#   jarvis resume-from-meeting   # (uso interno do watcher de reunião)

set -e

UNIT="voice-launcher.service"
RESUME_TIMER="jarvis-resume.timer"
STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
MARKER="$STATE_DIR/jarvis-meeting-paused"
WAKE_OFF="$STATE_DIR/jarvis-wake-off"
RESUME_AT_FILE="$STATE_DIR/jarvis-resume-at"

is_active() {
    systemctl --user is-active --quiet "$UNIT"
}

cancel_pending_resume() {
    systemctl --user stop "$RESUME_TIMER" 2>/dev/null || true
    rm -f "$RESUME_AT_FILE"
}

cmd_on() {
    cancel_pending_resume
    systemctl --user start "$UNIT"
    rm -f "$MARKER"
}

cmd_off() {
    cancel_pending_resume
    systemctl --user stop "$UNIT"
    rm -f "$MARKER"
}

cmd_toggle() {
    if is_active; then cmd_off; else cmd_on; fi
}

cmd_toggle_notify() {
    cmd_toggle
    local state
    state=$(cmd_status_short)
    notify-send -t 1500 "Jarvis" "agora $state" 2>/dev/null || true
}

cmd_status_short() {
    if is_active; then echo "on"; else echo "off"; fi
}

cmd_status() {
    # JSON pro waybar. alt define o ícone (on/off/paused); class aciona .on/.off/.paused no CSS.
    local text alt tooltip
    if is_active; then
        local since
        since=$(systemctl --user show "$UNIT" -p ActiveEnterTimestamp --value)
        if [ -f "$WAKE_OFF" ]; then
            text="manual"
            alt="manual"
            tooltip="Jarvis: ativo — só atalhos (wake word desligada)\ndesde $since"
        else
            text="on"
            alt="on"
            tooltip="Jarvis: ativo\ndesde $since"
        fi
    elif [ -f "$MARKER" ]; then
        text="paused"
        alt="paused"
        tooltip="Jarvis: pausado (reunião detectada)"
    elif systemctl --user is-active --quiet "$RESUME_TIMER"; then
        text="paused"
        alt="paused"
        local target now left
        target=$(cat "$RESUME_AT_FILE" 2>/dev/null || echo 0)
        now=$(date +%s)
        left=$((target - now))
        if [ "$left" -gt 3600 ]; then
            tooltip="Jarvis: pausado\nvolta em $((left/3600))h $(((left%3600)/60))min"
        elif [ "$left" -gt 60 ]; then
            tooltip="Jarvis: pausado\nvolta em $((left/60))min"
        elif [ "$left" -gt 0 ]; then
            tooltip="Jarvis: pausado\nvolta em ${left}s"
        else
            tooltip="Jarvis: pausado"
        fi
    else
        text="off"
        alt="off"
        tooltip="Jarvis: parado"
    fi
    printf '{"text":"%s","alt":"%s","class":"%s","tooltip":"%s"}\n' "$text" "$alt" "$alt" "$tooltip"
}

cmd_pause_notify() {
    local dur="${1:-30m}"
    cmd_pause "$dur"
    notify-send -t 2000 "Jarvis" "pausado por $dur" 2>/dev/null || true
}

cmd_pause() {
    local dur="${1:-}"
    if [ -z "$dur" ]; then
        echo "uso: jarvis pause <duração>  (ex: 30s, 45m, 1h, 2h30m)" >&2
        return 2
    fi
    cancel_pending_resume
    systemctl --user stop "$UNIT"
    # timer transiente que liga o serviço depois de <dur>
    systemd-run --user --quiet \
        --unit="${RESUME_TIMER%.timer}" \
        --on-active="$dur" \
        systemctl --user start "$UNIT"
    # guarda epoch alvo pro tooltip (systemd aceita '1h30m', date -d não)
    local secs
    secs=$(systemd-analyze timespan "$dur" 2>/dev/null | awk '/μs/ {print int($2/1000000)}')
    if [ -n "$secs" ]; then
        echo $(( $(date +%s) + secs )) > "$RESUME_AT_FILE"
    fi
    echo "Jarvis pausado. Volta em $dur."
}

cmd_pause_meeting() {
    # chamado pelo watcher quando outro app começa a usar o mic.
    # só age se o serviço estiver ativo — senão respeita o estado do user.
    if is_active; then
        systemctl --user stop "$UNIT"
        touch "$MARKER"
    fi
}

cmd_resume_from_meeting() {
    # só religa se foi o próprio watcher que desligou (marker existe).
    if [ -f "$MARKER" ] && ! is_active; then
        systemctl --user start "$UNIT"
        rm -f "$MARKER"
    fi
}

cmd_log() {
    shift || true
    journalctl --user -u "$UNIT" -f "$@"
}

cmd_wake() {
    # liga/desliga SÓ a escuta contínua do "hey jarvis". off = o serviço segue de
    # pé com o mic fechado; push-to-talk e ditado continuam funcionando. O efeito
    # é imediato (marcador em runtime) e persiste no config (wake_word_enabled).
    local action="${1:-toggle}" bindir
    bindir="$(dirname "$(readlink -f "$0")")"
    case "$action" in
        status) if [ -f "$WAKE_OFF" ]; then echo off; else echo on; fi; return 0 ;;
        toggle) if [ -f "$WAKE_OFF" ]; then action=on; else action=off; fi ;;
        on|off) ;;
        *) echo "uso: jarvis wake on|off|toggle|status" >&2; return 2 ;;
    esac
    if [ "$action" = off ]; then
        touch "$WAKE_OFF"
        python3 "$bindir/jarvis_config.py" set wake_word_enabled false >/dev/null
        echo "wake word off — só atalhos (push-to-talk/ditado)"
    else
        rm -f "$WAKE_OFF"
        python3 "$bindir/jarvis_config.py" set wake_word_enabled true >/dev/null
        echo "wake word on — escutando \"hey jarvis\""
    fi
}

cmd_dictate() {
    # ditado: start | stop | toggle | cancel  (Ctrl+Shift+K/L nos binds do Hyprland)
    local action="${1:-toggle}"
    local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    case "$action" in start|stop|toggle|cancel) ;; *) echo "uso: jarvis dictate start|stop|toggle|cancel" >&2; return 2 ;; esac
    if [ "$action" = start ] && [ -f "$rt/jarvis-dictating" ]; then return 0; fi
    if [ "$action" = stop ] || [ "$action" = cancel ]; then [ -f "$rt/jarvis-dictating" ] || return 0; fi
    if ! is_active; then
        notify-send -t 2500 "Jarvis" "desligado — ligue o Jarvis para ditar (jarvis on)" 2>/dev/null || true
        return 1
    fi
    echo "$action" > "$rt/jarvis-dictate.cmd"
    systemctl --user kill -s SIGUSR2 "$UNIT"
}

launch_tui() {
    # roda um script de TUI: direto se já há terminal; senão num terminal flutuante,
    # com fallback pros terminais comuns (fora do Omarchy: Ubuntu, Fedora, etc).
    local title="$1"; shift
    if [ -t 1 ]; then
        exec "$@"
    fi
    # TEMP(ghostty->alacritty 2026-09-01): ghostty 1.3.1 segfaulta (ghostty#11504).
    if command -v alacritty >/dev/null 2>&1; then
        local launch=(alacritty --class TUI.float --title "$title"
                      -o window.dimensions.columns=110 -o window.dimensions.lines=40 -e "$@")
        if command -v uwsm-app >/dev/null 2>&1; then exec uwsm-app -- "${launch[@]}"; fi
        exec "${launch[@]}"
    fi
    if command -v xdg-terminal-exec >/dev/null 2>&1; then exec xdg-terminal-exec "$@"; fi
    local term
    for term in x-terminal-emulator gnome-terminal konsole kitty alacritty foot xterm; do
        if command -v "$term" >/dev/null 2>&1; then
            case "$term" in
                gnome-terminal) exec "$term" --title="$title" -- "$@" ;;
                *)              exec "$term" -e "$@" ;;
            esac
        fi
    done
    echo "jarvis: nenhum terminal encontrado pra abrir a tela" >&2
    return 1
}

cmd_app() {
    # a MESMA interface do popup da bar, como janela própria:
    #   1. quickshell (Omarchy/Arch) roda o QML direto;
    #   2. PySide6 (Ubuntu etc.) roda o mesmo QML via Qt;
    #   3. sem Qt nenhum: versão terminal (curses), zero dependências.
    local bindir appdir
    bindir="$(dirname "$(readlink -f "$0")")"
    appdir="$HOME/.local/share/jarvis/app"
    [ -e "$appdir/qs/shell.qml" ] || appdir="$bindir/../app"
    if [ -e "$appdir/qs/shell.qml" ]; then
        if command -v quickshell >/dev/null 2>&1; then
            exec quickshell -p "$appdir/qs"
        fi
        if python3 -c 'import PySide6' 2>/dev/null; then
            exec python3 "$bindir/jarvis-panel.py" "$appdir"
        fi
    fi
    launch_tui "Jarvis" python3 "$bindir/jarvis-app.py"
}

cmd_config() {
    # sem args: tela de configuração em terminal flutuante.
    # com args (show|get|set|reset|path): passa pro CLI do módulo de config.
    local bindir
    bindir="$(dirname "$(readlink -f "$0")")"
    if [ $# -eq 0 ]; then
        launch_tui "Jarvis — configuração" python3 "$bindir/jarvis-config.py"
        return
    fi
    exec python3 "$bindir/jarvis_config.py" "$@"
}

case "${1:-}" in
    on)                   cmd_on ;;
    off)                  cmd_off ;;
    toggle)               cmd_toggle ;;
    toggle-notify)        cmd_toggle_notify ;;
    status)               cmd_status ;;
    status-short)         cmd_status_short ;;
    pause)                cmd_pause "${2:-}" ;;
    pause-notify)         cmd_pause_notify "${2:-30m}" ;;
    pause-meeting)        cmd_pause_meeting ;;
    resume-from-meeting)  cmd_resume_from_meeting ;;
    app)                  cmd_app ;;
    log)                  cmd_log "$@" ;;
    config)               shift; cmd_config "$@" ;;
    wake)                 cmd_wake "${2:-toggle}" ;;
    dictate)              cmd_dictate "${2:-toggle}" ;;
    *)
        sed -n '2,13p' "$0" | sed 's/^# \?//'
        exit 2
        ;;
esac
